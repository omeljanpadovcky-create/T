P2P_FIAT=UAH
P2P_ASSET=USDT
P2P_EXCHANGES_FILE=exchanges.json
# Optional override: comma-separated ids, e.g. binance,bybit,okx
P2P_EXCHANGES=
P2P_SCAN_SECONDS=15
P2P_MIN_NET_PCT=0.35
P2P_MAX_RISK=60
P2P_MIN_COMPLETION=90
P2P_MIN_ORDERS=10
P2P_SAFETY_BUFFER_PCT=0.15
P2P_BINANCE_ENABLED=1
P2P_BYBIT_ENABLED=1

# Personal Bank Guard thresholds — safety settings, NOT bank/legal limits.
P2P_BANK_WARN_TRANSFERS_PER_DAY=4
P2P_BANK_MAX_TRANSFERS_PER_DAY=6
P2P_BANK_TRANSFERS_PER_CYCLE=2
P2P_BANK_MIN_MINUTES_BETWEEN_CYCLES=60
P2P_BANK_MAX_ALERTS_PER_DAY=8

# Telegram/dashboard warning after the Nth confirmed route check/open.
P2P_TELEGRAM_CONFIRM_WARN=5
P2P_DASHBOARD_URL=https://omeljanpadovcky-create.github.io/T/

# Existing root .env aliases TG_BOT_TOKEN / TG_CHAT_ID are also accepted.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bybit P2P API needs General Advertiser status or higher.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Enable only after normal git push from this local clone works without prompts.
P2P_GIT_PUSH=1
P2P_GIT_SYNC_SECONDS=60


# Біржі з офіційним P2P API
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

GATE_API_KEY=
GATE_API_SECRET=

# Заготовки для наступних адаптерів
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
MEXC_API_KEY=
MEXC_API_SECRET=
HTX_API_KEY=
HTX_API_SECRET=
BINGX_API_KEY=
BINGX_API_SECRET=
COINEX_API_KEY=
COINEX_API_SECRET=
WHITEBIT_API_KEY=
WHITEBIT_API_SECRET=
LBANK_API_KEY=
LBANK_API_SECRET=
COINW_API_KEY=
COINW_API_SECRET=
TOOBIT_API_KEY=
TOOBIT_API_SECRET=
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
WEEX_API_KEY=
WEEX_API_SECRET=
DIGIFINEX_API_KEY=
DIGIFINEX_API_SECRET=
BITMART_API_KEY=
BITMART_API_SECRET=

# Store real values in Vercel Environment Variables; never commit secrets.
# Full Etsy API header value: keystring:shared_secret
ETSY_API_KEY=
# Long random private token gating access to paid AI drafting
MYSHKA_ACCESS_TOKEN=
# Optional OpenAI API key; configure only after the access token is set
OPENAI_API_KEY=
# Optional model name; defaults to gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
